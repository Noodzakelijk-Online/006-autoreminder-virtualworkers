{
  "manifest_version": 3,
  "name": "Joyce Browser Hygiene",
  "version": "1.0.0",
  "description": "Reports local Chrome tab counts to Joyce Work Schedule and provides explicit tab cleanup.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Review open work tabs",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
